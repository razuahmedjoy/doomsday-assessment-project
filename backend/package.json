{
  "name": "doomsday-ready-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "postinstall": "prisma generate",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
